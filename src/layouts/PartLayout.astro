---
/**
 * One part of a grounding — a chapter, on its own page.
 *
 * A part IS an essay in every respect except its header, so it uses the same
 * `.article*` classes from styles/article.css rather than a parallel set that
 * happens to match today. The only differences are what replaces the dateline
 * (position in the work), the running head, and the navigation at the foot.
 *
 * There is no second level of division. Parts are the chapters; nothing
 * nests inside them but sections.
 */
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { scanCitations, citeId, sourceId } from '../lib/citations';
import {
  GROUNDINGS, groundingHref, partHref, roman, type Part,
} from '../lib/groundings';

interface Props {
  grounding: string;
  part: Part;
  headings: MarkdownHeading[];
  total: number;
  previous?: Part;
  next?: Part;
}

const { grounding, part, total, previous, next } = Astro.props;
const work = GROUNDINGS[grounding];
const { title, deck, sources } = part.data;
const n = part.data.part;

// Same audit as an essay, same reasons — see lib/citations. Per part, because
// each part is its own page and carries its own bibliography.
const citedCounts = scanCitations(part.body ?? '');
{
  const declared = new Set((sources ?? []).map((s) => s.key));
  for (const key of citedCounts.keys()) {
    if (!declared.has(key)) {
      throw new Error(
        `${part.id}: <Cite source="${key}"> does not match any entry in this part's sources. ` +
          `Declared keys: ${[...declared].join(', ') || '(none)'}.`,
      );
    }
  }
  for (const source of sources ?? []) {
    if (!citedCounts.has(source.key) && !source.background) {
      throw new Error(
        `${part.id}: source "${source.key}" is never cited. ` +
          `Cite it, mark it \`background: true\`, or remove it.`,
      );
    }
  }
}
---

<BaseLayout title={`${title} — ${work.short}`} description={deck}>
  {/* Sticky, and empty until the header has scrolled away. Answers "where am
      I in this part", which is the question that only appears once a part
      runs long. Position in the WORK is answered statically below. */}
  <div class="runninghead" data-runninghead hidden>
    <div class="runninghead__inner">
      <a class="runninghead__work" href={groundingHref(grounding)}>{work.short}</a>
      <span class="runninghead__part">Part {roman(n)}</span>
      <span class="runninghead__section" data-runninghead-section></span>
    </div>
    {/* The rule under the running head IS the progress indicator — it fills
        from the left as you move through the part. No new page furniture:
        the line was already there doing a different job. */}
    <span class="runninghead__progress" data-runninghead-progress aria-hidden="true"></span>
  </div>

  <article class="article">
    <header class="article__header">
      {/* A LABEL, NOT A BREADCRUMB. It occupies the dateline's slot and takes
          its styling: an essay says when, a part says where.

          The grounding's name used to be a link here, which made the line a
          half-breadcrumb — it looked like metadata and behaved like
          navigation, and a reader could not tell from looking which it was.
          Navigation now lives in three places that are unambiguously
          navigation: the site header, the running head, and the foot.

          It carries the POSITION only, not the grounding's name. The short
          name is a truncation made for the running head, where a link needs
          something to say; standing alone above a title it reads as the
          grounding's identity while being no such thing. The title of the
          part and the contents link at the foot say what this belongs to. */}
      <p class="article__dateline label">
        <span>Part {roman(n)} of {roman(total)}</span>
      </p>
      <h1 class="article__title display-title">{title}</h1>
      {deck && <p class="article__deck">{deck}</p>}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article__foot stub">
      {
        sources && sources.length > 0 && (
          <aside class="article__sources" aria-labelledby="sources-heading">
            <h2 id="sources-heading" class="label">
              Sources
            </h2>
            <ul>
              {sources.map((source) => {
                const uses = citedCounts.get(source.key) ?? 0;
                return (
                  <li id={sourceId(source.key)}>
                    <span class="article__source-text">{source.text}</span>
                    {Array.from({ length: uses }, (_, i) => (
                      <a class="article__source-back" href={`#${citeId(source.key, i + 1)}`}>
                        <span aria-hidden="true">↩</span>
                        {uses > 1 && <span class="article__source-backnum">{i + 1}</span>}
                        <span class="u-sr-only">Back to citation in the text</span>
                      </a>
                    ))}
                    {source.background && (
                      <span class="article__source-background">Background</span>
                    )}
                  </li>
                );
              })}
            </ul>
          </aside>
        )
      }

      {/* Three slots, always: back, up, forward. The contents link is
          unconditional because a reader who arrived at Part V from a shared
          link has no other way up that does not require scrolling to find the
          running head. */}
      <nav class="part-nav" aria-label="Parts">
        <div class="part-nav__slot">
          {previous && (
            <a class="part-nav__link" href={partHref(grounding, previous)}>
              <span class="label">Part {roman(previous.data.part)}</span>
              <span class="part-nav__title">{previous.data.title}</span>
            </a>
          )}
        </div>

        <div class="part-nav__slot part-nav__slot--up">
          <a class="part-nav__link" href={groundingHref(grounding)}>
            <span class="label">Contents</span>
            <span class="part-nav__title">{work.short}</span>
          </a>
        </div>

        <div class="part-nav__slot part-nav__slot--next">
          {next && (
            <a class="part-nav__link" href={partHref(grounding, next)}>
              <span class="label">Part {roman(next.data.part)}</span>
              <span class="part-nav__title">{next.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    </footer>
  </article>
</BaseLayout>

<script>
  // Names the section the reader is currently inside. The only client JS on
  // the site. Binds on astro:page-load, not DOMContentLoaded — with the
  // client router the second navigation never fires the latter.
  function setUpRunningHead() {
    const bar = document.querySelector<HTMLElement>('[data-runninghead]');
    const out = document.querySelector<HTMLElement>('[data-runninghead-section]');
    const header = document.querySelector<HTMLElement>('.article__header');
    if (!bar || !out || !header) return;

    const sections = [...document.querySelectorAll<HTMLElement>('.prose h2')];
    if (!sections.length) return;

    // Hidden while the title is still on screen — it already says where you
    // are, and two answers to one question is worse than one.
    const watch = new IntersectionObserver(
      ([entry]) => {
        bar.hidden = entry.isIntersecting;
      },
      { threshold: 0 },
    );
    watch.observe(header);

    // Computed from scroll offset rather than intersection ratios: a section
    // taller than the viewport intersects nothing, and parts are meant to run
    // long.
    const prose = document.querySelector<HTMLElement>('.prose');
    const progress = document.querySelector<HTMLElement>('[data-runninghead-progress]');

    const update = () => {
      const y = window.scrollY + 96;
      let current = sections[0];
      for (const s of sections) {
        if (s.offsetTop <= y) current = s;
        else break;
      }
      const label = current.textContent?.trim() ?? '';
      if (out.textContent !== label) out.textContent = label;

      // Progress through the PROSE, not through the document: the sources and
      // the part navigation are not reading, and counting them would report
      // 90% while the argument is still going.
      if (prose && progress) {
        const start = prose.offsetTop;
        const end = start + prose.offsetHeight - window.innerHeight;
        const ratio = end <= start ? 1 : (window.scrollY - start) / (end - start);
        const clamped = Math.min(1, Math.max(0, ratio));
        progress.style.transform = `scaleX(${clamped})`;
      }
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', update);
        watch.disconnect();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', setUpRunningHead);
</script>

<style>
  /* ==========================================================================
     RUNNING HEAD
     What a printed book does. Sticky, apparatus register, and it replaces
     TEXT rather than animating geometry — which is why it costs the motion
     doctrine nothing where a filling progress bar would have cost it a rule.
     ====================================================================== */

  .runninghead {
    position: relative;
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    background: var(--paper);
    border-block-end: var(--rule-weight) solid var(--rule);
    /* Full bleed, so its rule reads as the edge of a page rather than a
       floating box. See the overflow note on html in global.css. */
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(50vw - 50%);
  }

  .runninghead__inner {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    max-width: var(--grid-figure-span);
    margin-inline: auto;
    padding-block: var(--space-3);
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    font-weight: var(--weight-medium);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--muted);
    line-height: 1.4;
  }

  .runninghead__work {
    color: var(--ink);
    text-decoration: none;
  }

  /* Sits exactly on the border-block-end, so the neutral rule and the filled
     rule are the same line rather than two stacked ones.

     NO TRANSITION, deliberately. It is driven by scroll position and nothing
     else, so it moves only as fast as the reader does — which is what keeps
     it from being an animation playing at them. */
  .runninghead__progress {
    position: absolute;
    inset-block-end: calc(-1 * var(--rule-weight));
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: var(--rule-weight);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    /* Eased, so the rule trails the scroll and settles rather than snapping
       frame-by-frame with it. Linear rather than a curve: an ease-out would
       make it lunge and then creep, which draws the eye — the point is that
       it should be findable when looked for and unnoticeable when not.

       This is a revision to condition 2 of the motion amendment in
       tokens.css, which originally forbade any transition. The condition was
       written to keep the indicator from animating AT the reader; a 240ms
       linear catch-up does the opposite, since it removes the jitter that was
       drawing attention in the first place. */
    transition: transform 240ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Asked for no motion: the rule still reports position, it just arrives
       there immediately instead of travelling. */
    .runninghead__progress {
      transition: none;
    }
  }

  .runninghead__section {
    /* The only part that changes, and the reason the bar exists. Truncated
       rather than wrapped: a running head that grows to two lines moves the
       page under the reader. */
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
    font-weight: var(--weight-regular);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ==========================================================================
     NAV
     ====================================================================== */

  .part-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-4);
    border-block-start: var(--rule-weight) solid var(--rule);
  }

  .part-nav__slot--up {
    text-align: center;
  }

  .part-nav__slot--next {
    text-align: end;
  }

  .part-nav__link {
    display: block;
    max-width: 22ch;
    color: var(--ink);
    text-decoration: none;
  }

  .part-nav__slot--up .part-nav__link {
    margin-inline: auto;
  }

  .part-nav__slot--next .part-nav__link {
    margin-inline-start: auto;
  }

  .part-nav__title {
    display: block;
    margin-block-start: var(--space-1);
    font-family: var(--font-doc);
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-leading);
  }

  .part-nav__link:hover .part-nav__title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 56.25em) {
    /* Duplicated from --bp-margin-collapse; media conditions cannot read
       custom properties. */
    .part-nav {
      grid-template-columns: 1fr;
    }

    .part-nav__slot--up,
    .part-nav__slot--next {
      text-align: start;
    }

    .part-nav__slot--up .part-nav__link,
    .part-nav__slot--next .part-nav__link {
      margin-inline: 0;
    }
  }
</style>
