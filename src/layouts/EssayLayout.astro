---
/**
 * The editorial register: essays and cases.
 *
 * Three columns — margin, gutter, main — centred at the figure span. The
 * title and any figure break out of the main column to that full span; the
 * prose does not. The margin column carries the apparatus: dateline, sources,
 * sidenotes, figure numbers.
 *
 * Below --bp-margin-collapse the grid becomes a single column and the
 * apparatus falls into the flow. Because every region is placed explicitly by
 * row and column, DOM order is already the collapsed order: dateline, prose,
 * sources. The media query only has to switch the display mode.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { kindLabel } from '../lib/format';
import Breadcrumb from '../components/Breadcrumb.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Byline from '../components/Byline.astro';
import { scanCitations, citeId, sourceId } from '../lib/citations';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, deck, date, updated, kind, tags, sources } = post.data;

/**
 * Both directions are audited, because both are silent failures otherwise: a
 * citation pointing at nothing renders a dead link, and a source citing
 * nothing sits in the bibliography looking like evidence.
 *
 * Counts come from the post's source text, not from the render-time registry —
 * see the note on scanCitations for why the registry cannot answer this.
 */
const citedCounts = scanCitations(post.body ?? '');

{
  const declared = new Set((sources ?? []).map((s) => s.key));

  for (const key of citedCounts.keys()) {
    if (!declared.has(key)) {
      throw new Error(
        `${post.id}: <Cite source="${key}"> does not match any entry in this post's sources. ` +
          `Declared keys: ${[...declared].join(', ') || '(none)'}.`,
      );
    }
  }

  for (const source of sources ?? []) {
    if (!citedCounts.has(source.key) && !source.background) {
      throw new Error(
        `${post.id}: source "${source.key}" is never cited. ` +
          `Cite it with <Cite source="${source.key}">…</Cite>, mark it \`background: true\` if it informed the piece ` +
          `without supporting a particular sentence, or remove it. An uncited source looks like evidence and is not.`,
      );
    }
  }
}
---

<BaseLayout title={title} description={deck}>
  <article class="article">
    <header class="article__header">
      <div class="article__topline">
        <Breadcrumb trail={[{ href: '/essays/', label: 'Essays' }]} />
      </div>

      <h1 class="article__title display-title">{title}</h1>

      {/* Optional. A standfirst is a judgement about a particular piece; a
          piece that does not want one gets a title and then its first
          sentence, which is how most good essays open anyway. */}
      {deck && <p class="article__deck">{deck}</p>}

      <div class="article__band">
        <Byline />
        <ArticleMeta kind={kindLabel(kind)} published={date} updated={updated} />
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article__foot stub">
      {
        sources && sources.length > 0 && (
          <aside class="article__sources" aria-labelledby="sources-heading">
            <h2 id="sources-heading" class="label">
              Sources
            </h2>
            <ul>
              {sources.map((source) => {
                const uses = citedCounts.get(source.key) ?? 0;
                return (
                  <li id={sourceId(source.key)}>
                    <span class="article__source-text">{source.text}</span>
                    {/* Back-links to every place the source was used — the
                        direction a reader at the foot of the page actually
                        wants. Numbered only when there is more than one, so a
                        single citation gets a bare arrow rather than a "1"
                        that could be mistaken for a sidenote marker. */}
                    {Array.from({ length: uses }, (_, i) => (
                      <a class="article__source-back" href={`#${citeId(source.key, i + 1)}`}>
                        <span aria-hidden="true">↩</span>
                        {uses > 1 && <span class="article__source-backnum">{i + 1}</span>}
                        <span class="u-sr-only">
                          Back to citation {uses > 1 ? i + 1 : ''} in the text
                        </span>
                      </a>
                    ))}
                    {source.background && (
                      <span class="article__source-background">Background</span>
                    )}
                  </li>
                );
              })}
            </ul>
          </aside>
        )
      }

      {
        tags.length > 0 && (
          <p class="article__tags label">Filed under {tags.join(' · ')}</p>
        )
      }

      {/* A way up at the foot as well as the top. Parts have had this since
          they were paginated; essays reached the end and offered nothing. */}
      <nav class="article__up" aria-label="Essays">
        <a href="/essays/">
          <span class="label">All essays</span>
        </a>
      </nav>
    </footer>
  </article>
</BaseLayout>
