---
/**
 * The document shell. Everything on the site renders through this — it owns
 * the <head>, the font links, the site header and footer, and nothing else.
 * It knows nothing about posts.
 */
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/article.css';

interface Props {
  title: string;
  /** Meta description. Falls back to the site line when a page has none. */
  description?: string;
  /**
   * Open Graph type. `article` for a thing someone wrote — an essay or a
   * part; `website` for the listings, the spine, and the 404. Defaults to
   * `website` because most pages here are not articles and the ones that are
   * go through a layout that can say so.
   */
  ogType?: 'website' | 'article';
}

/**
 * The site is BRAND PONDERATIO; the author is Muhammad Ibrahim. Keeping the two
 * apart is what lets the header carry a mark and the articles carry a byline
 * — the emblem says whose publication this is, the byline says who wrote the
 * thing you are reading.
 */
const SITE_TITLE = 'Brand Ponderatio';
const SITE_DESCRIPTION =
  'Essays and groundings — long arguments, published complete.';

const {
  title,
  description = SITE_DESCRIPTION,
  ogType = 'website',
} = Astro.props;

// The home page sets its title to the site name; every other page is
// suffixed. Avoids the "Muhammad Ibrahim — Muhammad Ibrahim" case.
const documentTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;

/**
 * The two kinds of thing on the site, each with its own listing. There is no
 * "Index" link: the site name already goes home, and a nav item pointing at
 * the page you reach by clicking the name above it is a duplicate.
 */
const nav = [
  { href: '/essays/', label: 'Essays' },
  { href: '/groundings/', label: 'Groundings' },
];

const currentPath = Astro.url.pathname;

/**
 * ABSOLUTE URLS ONLY EXIST ONCE `site` IS SET in astro.config.mjs.
 *
 * A canonical link or an og:image has to be absolute — a crawler or an
 * unfurler resolves them against nothing. Until the domain is decided,
 * `Astro.site` is undefined and `Astro.url` carries the dev server's origin,
 * so emitting these tags would ship `http://localhost:4321` into production
 * HTML. Wrong beats absent here: a missing canonical is a shrug, a canonical
 * pointing at localhost is an instruction to de-index.
 *
 * So the tags below are gated on `site`. Set it and they appear, correct,
 * with no further edit to this file.
 */
const canonical = Astro.site
  ? new URL(currentPath, Astro.site).href
  : undefined;
const socialImage = Astro.site
  ? new URL('/og.png', Astro.site).href
  : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* The emblem is the favicon too — one mark, everywhere it appears. */}
    <link rel="icon" type="image/svg+xml" href="/emblem.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Relative on purpose: a feed autodiscovery link is resolved against the
        page it sits on, so this needs no origin and cannot go stale. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_TITLE} — essays and groundings`}
      href="/rss.xml"
    />

    {/* HOW THE SITE LOOKS WHEN IT IS NOT THE SITE — pasted into a message, a
        feed, a chat. The card is the only typography most people will ever
        see of a link they did not follow, so it is not an afterthought.

        og:title is the BARE title, not documentTitle: the card renders the
        site name on its own line from og:site_name, and "X — Brand
        Ponderatio" under a byline reading "Brand Ponderatio" says it twice.

        The type is `article` only for things that are articles; the listings
        and the 404 are `website`. Unfurlers use it to decide whether to look
        for a published date. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      socialImage && (
        <>
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${SITE_TITLE} — the emblem`} />
        </>
      )
    }

    {/* summary_large_image, not summary: the card is a wide mark on paper,
        and the small square variant crops it to a thumbnail that reads as a
        smudge. Falls back to the og: tags for everything else. */}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Both are preloaded. Neither is optional on a first paint: the working
        face carries the essay body and every label on the page, and the
        document face carries the title above them — a title arriving a frame
        late is the most visible reflow the page can have. */}
    <Font cssVariable="--font-working" preload />
    <Font cssVariable="--font-document" preload />

    {/* Cross-page fade. The animation itself is scoped to the main column
        below; ClientRouter is what makes the navigation client-side so the
        header and margin column can survive it.

        NOTE for later: with the client router in place, any GSAP setup must
        run on `astro:page-load`, not on a bare DOMContentLoaded — the second
        navigation never fires the latter. */}
    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="site-header__mark" href="/" aria-label={`${SITE_TITLE} — home`}>
        <img src="/emblem.svg" alt="" width="24" height="29" />
      </a>
      <nav aria-label="Sections">
        <ul class="site-header__nav">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={
                    currentPath.startsWith(item.href) ? 'page' : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" transition:name="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
    </footer>
  </body>
</html>

<style>
  /* Header and footer share the grid's width, so the mark sits on the same
     outer edge the margin column starts at and the nav ends where the title
     ends. The padding is added outside the span so their CONTENT edge — not
     their box edge — lands on the grid's line. */
  .site-header,
  .site-footer {
    max-width: calc(var(--grid-figure-span) + 2 * var(--space-5));
  }

  main {
    max-width: var(--grid-content-max);
  }

  .site-header,
  .site-footer,
  main {
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-5);
    inset-block-start: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--paper);
    border: var(--rule-weight) solid var(--rule);
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    text-decoration: none;
    /* Off-screen until focused, but never `display: none` — that would take
       it out of the tab order, which defeats the point. */
    transform: translateY(-200%);
    z-index: 1;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* ==========================================================================
     SITE HEADER
     Sans throughout. It is chrome, not content, and reads as apparatus.
     ====================================================================== */

  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    /* Centred rather than baseline-aligned: the mark is an image and has no
       baseline to align to, so baseline alignment hung it above the nav. */
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6) var(--space-9);
  }

  /* The emblem replaces the wordmark. It is the one place the accent appears
     as IDENTITY rather than as a mark that carries information — recorded as
     an exception in tokens.css rather than left to look like a slip. */
  .site-header__mark {
    display: block;
    line-height: 0;
  }

  .site-header__mark img {
    display: block;
    /* Height-led, because the emblem is portrait and the header is a line of
       text: setting the height and letting the width follow is what makes the
       mark and the nav sit as one row. It stands taller than the nav's cap
       height on purpose — it is the identity, not a third link — and the row
       is centred, so growing it moves nothing else: the left edge stays on
       the grid line and the extra height falls evenly above and below the
       centre the nav is already aligned to. */
    height: 2.75rem;
    width: auto;
  }

  .site-header__nav {
    display: flex;
    /* Centred, so the links' own boxes centre inside the row rather than
       stretching to it — without this the emblem's centre and the caps'
       centre sat 3.5px apart, which is small and visible. */
    align-items: center;
    gap: var(--space-5);
  }

  .site-header__nav a {
    /* Block with a tight line box, so the box the flexbox centres is the
       height of the capitals rather than the height of a line of text with
       its leading. */
    display: block;
    line-height: 1;
  }

  .site-header__nav a {
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    color: var(--muted);
    text-decoration: none;
  }

  .site-header__mark:hover {
    opacity: 0.75;
  }

  .site-header__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* ==========================================================================
     SITE FOOTER
     ====================================================================== */

  .site-footer {
    margin-block-start: var(--space-10);
    padding-block: var(--space-5) var(--space-8);
    border-block-start: var(--rule-weight) solid var(--rule);
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    color: var(--muted);
  }
</style>

<style is:global>
  /* The cross-page transition: a fade on the main column ONLY.

     The default view transition animates `root`, which is the entire page —
     header included. That is explicitly not what this design wants, so the
     root animation is cancelled and the fade is re-applied to the named
     `main` group instead. The header and footer stay in the root snapshot,
     now un-animated, and so hold still across the navigation.

     Astro's client router disables view-transition animations outright under
     prefers-reduced-motion, so this needs no media query of its own. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  @keyframes main-fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes main-fade-out {
    to {
      opacity: 0;
    }
  }

  ::view-transition-old(main) {
    animation: main-fade-out var(--motion-page-fade) var(--motion-ease) both;
  }

  ::view-transition-new(main) {
    animation: main-fade-in var(--motion-page-fade) var(--motion-ease) both;
  }
</style>
