---
/**
 * One chapter of an inquiry — the atomic unit, on its own page.
 *
 * A chapter IS an essay in every respect except its header, so it uses the
 * same `.article*` classes from styles/article.css rather than a parallel set
 * that happens to match today. The differences are the position line that
 * replaces the dateline's kind label, the running head, and the navigation at
 * the foot.
 *
 * CHAPTERS ARE LONG. Nothing has been added to this page that competes with
 * the body text — no reading-progress widget beyond the rule that was already
 * under the running head, no floating anything, no estimated read time. The
 * measure, the leading and the vertical rhythm are the design.
 */
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { scanCitations, citeId, sourceId } from '../lib/citations';
import Breadcrumb from '../components/Breadcrumb.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Byline from '../components/Byline.astro';
import {
  inquiryHref, chapterHref, inquirySlug, spelledOut,
  type Chapter, type Inquiry,
} from '../lib/inquiries';
import { chapterCardUrl } from '../lib/og-pieces';

interface Props {
  inquiry: Inquiry;
  chapter: Chapter;
  headings: MarkdownHeading[];
  /** The chapter's part, already resolved. Absent for a flat inquiry. */
  part?: { number: number; title: string };
  /** Live chapters only — an unpublished neighbour is not a neighbour. */
  previous?: Chapter;
  next?: Chapter;
}

const { inquiry, chapter, part, previous, next } = Astro.props;
const slug = inquirySlug(inquiry);
const work = inquiry.data;
const { title, deck, date, updated, sources } = chapter.data;
const n = chapter.data.number;

// Same audit as an essay, same reasons — see lib/citations. Per chapter,
// because each chapter is its own page and carries its own bibliography.
const citedCounts = scanCitations(chapter.body ?? '');
{
  const declared = new Set((sources ?? []).map((s) => s.key));
  for (const key of citedCounts.keys()) {
    if (!declared.has(key)) {
      throw new Error(
        `${chapter.id}: <Cite source="${key}"> does not match any entry in this chapter's sources. ` +
          `Declared keys: ${[...declared].join(', ') || '(none)'}.`,
      );
    }
  }
  for (const source of sources ?? []) {
    if (!citedCounts.has(source.key) && !source.background) {
      throw new Error(
        `${chapter.id}: source "${source.key}" is never cited. ` +
          `Cite it, mark it \`background: true\`, or remove it.`,
      );
    }
  }
}
---

<BaseLayout
  title={`${title} — ${work.title}`}
  description={deck}
  ogType="article"
  ogImage={chapterCardUrl(inquiry, chapter)}
>
  {/* Sticky, and empty until the header has scrolled away. Answers "where am
      I in this part", which is the question that only appears once a part
      runs long. Position in the WORK is answered statically below. */}
  <div class="runninghead" data-runninghead hidden>
    <div class="runninghead__inner">
      {/* "Contents" rather than the work's name: the bar is sticky and has
          no room for a 32-character title, and the answer to that is to name
          the DESTINATION rather than abbreviate the title. */}
      <a class="runninghead__work" href={inquiryHref(slug)}>Contents</a>
      <span class="runninghead__part">Chapter {n}</span>
      <span class="runninghead__section" data-runninghead-section></span>
    </div>
    {/* The rule under the running head IS the progress indicator — it fills
        from the left as you move through the part. No new page furniture:
        the line was already there doing a different job. */}
    <span class="runninghead__progress" data-runninghead-progress aria-hidden="true"></span>
  </div>

  <article class="article">
    <header class="article__header">
      <div class="article__topline">
        {/* THE FULL TRAIL: Inquiries / <the work>. It stops at the parent,
            per the Breadcrumb component's first rule — the h1 below already
            says which chapter this is.

            It briefly stopped at "Inquiries" alone, on the theory that the
            work was named in the position line below and a second mention
            would be redundant. That had it backwards. A breadcrumb's job is
            to show the path and offer the way back up it, and a one-item
            trail shows no path at all. The position line is orientation, not
            navigation, and it cannot stand in for the trail. */}
        <Breadcrumb
          trail={[
            { href: '/inquiries/', label: 'Inquiries' },
            { href: inquiryHref(slug), label: work.title },
          ]}
        />
      </div>

      {/* THE POSITION LINE — where this chapter sits INSIDE the work. It no
          longer repeats the work's name: the breadcrumb above carries that
          now, and carrying it twice, two lines apart, is exactly what the
          breadcrumb's own rules exist to prevent.

          What is left is the part and the chapter, which a breadcrumb
          genuinely cannot express — a part has no page to link to, and a
          breadcrumb never ends at the page you are on. The Part segment
          disappears entirely for a flat inquiry rather than degrading to
          something; see the degradation rule in lib/inquiries.

          Position line and title share the header's title row — see the note
          on the four-row contract in styles/article.css. */}
      <div class="position__block">
        <p class="position">
          {part && (
            <span class="position__seg">
              <span class="position__level">Part</span>
              <span class="position__word">{spelledOut(part.number)}</span>
              <span class="position__dot" aria-hidden="true">·</span>
            </span>
          )}

          <span class="position__seg">
            <span class="position__level">Chapter</span>
            <span class="position__arabic">{n}</span>
          </span>
        </p>

      <h1 class="article__title display-title">{title}</h1>
      </div>

      {deck && <p class="article__deck">{deck}</p>}

      <div class="article__band">
        {/* NO `kind`, exactly as an essay passes none. The band is provenance
            — who wrote this, and when — and a position label wedged in beside
            the author's name was answering a question already answered twice
            above it, in the breadcrumb and in the position line. */}
        <Byline />
        <ArticleMeta published={date} updated={updated} />
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article__foot stub">
      {
        sources && sources.length > 0 && (
          <aside class="article__sources" aria-labelledby="sources-heading">
            <h2 id="sources-heading" class="label">
              Sources
            </h2>
            <ul>
              {sources.map((source) => {
                const uses = citedCounts.get(source.key) ?? 0;
                return (
                  <li id={sourceId(source.key)}>
                    <span class="article__source-text">{source.text}</span>
                    {Array.from({ length: uses }, (_, i) => (
                      <a class="article__source-back" href={`#${citeId(source.key, i + 1)}`}>
                        <span aria-hidden="true">↩</span>
                        {uses > 1 && <span class="article__source-backnum">{i + 1}</span>}
                        <span class="u-sr-only">Back to citation in the text</span>
                      </a>
                    ))}
                    {source.background && (
                      <span class="article__source-background">Background</span>
                    )}
                  </li>
                );
              })}
            </ul>
          </aside>
        )
      }

      {/* Three slots, always: back, up, forward. The contents link is
          unconditional because a reader who arrived at Chapter 5 from a
          shared link has no other way up that does not require scrolling to
          find the running head.

          NEVER LEAVES THE INQUIRY. Previous and next are the neighbouring
          chapters of this work and nothing else — a "next" that landed the
          reader in an essay, or in a different inquiry, would be presenting
          two unrelated pieces as consecutive moves in one argument. Where
          there is no neighbour the slot stays empty; the end of the published
          run is a real fact and the gap states it. */}
      <nav class="part-nav" aria-label="Chapters">
        <div class="part-nav__slot">
          {previous && (
            <a class="part-nav__link" href={chapterHref(slug, previous)}>
              <span class="label">Chapter {previous.data.number}</span>
              <span class="part-nav__title">{previous.data.title}</span>
            </a>
          )}
        </div>

        <div class="part-nav__slot part-nav__slot--up">
          <a class="part-nav__link" href={inquiryHref(slug)}>
            <span class="label">Contents</span>
            <span class="part-nav__title">{work.title}</span>
          </a>
        </div>

        <div class="part-nav__slot part-nav__slot--next">
          {next && (
            <a class="part-nav__link" href={chapterHref(slug, next)}>
              <span class="label">Chapter {next.data.number}</span>
              <span class="part-nav__title">{next.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    </footer>
  </article>
</BaseLayout>

<script>
  // Names the section the reader is currently inside. The only client JS on
  // the site. Binds on astro:page-load, not DOMContentLoaded — with the
  // client router the second navigation never fires the latter.
  function setUpRunningHead() {
    const bar = document.querySelector<HTMLElement>('[data-runninghead]');
    const out = document.querySelector<HTMLElement>('[data-runninghead-section]');
    const header = document.querySelector<HTMLElement>('.article__header');
    if (!bar || !out || !header) return;

    const sections = [...document.querySelectorAll<HTMLElement>('.prose h2')];
    if (!sections.length) return;

    // Hidden while the title is still on screen — it already says where you
    // are, and two answers to one question is worse than one.
    const watch = new IntersectionObserver(
      ([entry]) => {
        bar.hidden = entry.isIntersecting;
      },
      { threshold: 0 },
    );
    watch.observe(header);

    // Computed from scroll offset rather than intersection ratios: a section
    // taller than the viewport intersects nothing, and parts are meant to run
    // long.
    const prose = document.querySelector<HTMLElement>('.prose');
    const progress = document.querySelector<HTMLElement>('[data-runninghead-progress]');

    const update = () => {
      const y = window.scrollY + 96;
      let current = sections[0];
      for (const s of sections) {
        if (s.offsetTop <= y) current = s;
        else break;
      }
      const label = current.textContent?.trim() ?? '';
      if (out.textContent !== label) out.textContent = label;

      // Progress through the PROSE, not through the document: the sources and
      // the part navigation are not reading, and counting them would report
      // 90% while the argument is still going.
      if (prose && progress) {
        const start = prose.offsetTop;
        const end = start + prose.offsetHeight - window.innerHeight;
        const ratio = end <= start ? 1 : (window.scrollY - start) / (end - start);
        const clamped = Math.min(1, Math.max(0, ratio));
        progress.style.transform = `scaleX(${clamped})`;
      }
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', update);
        watch.disconnect();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', setUpRunningHead);
</script>

<style>
  /* ==========================================================================
     RUNNING HEAD
     What a printed book does. Sticky, apparatus register, and it replaces
     TEXT rather than animating geometry — which is why it costs the motion
     doctrine nothing where a filling progress bar would have cost it a rule.
     ====================================================================== */

  .runninghead {
    position: relative;
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    background: var(--paper);
    border-block-end: var(--rule-weight) solid var(--rule);
    /* Full bleed, so its rule reads as the edge of a page rather than a
       floating box. See the overflow note on html in global.css. */
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(50vw - 50%);
  }

  .runninghead__inner {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    max-width: var(--grid-figure-span);
    margin-inline: auto;
    padding-block: var(--space-3);
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    font-weight: var(--weight-medium);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--muted);
    line-height: 1.4;
  }

  .runninghead__work {
    color: var(--ink);
    text-decoration: none;
  }

  /* Sits exactly on the border-block-end, so the neutral rule and the filled
     rule are the same line rather than two stacked ones.

     NO TRANSITION, deliberately. It is driven by scroll position and nothing
     else, so it moves only as fast as the reader does — which is what keeps
     it from being an animation playing at them. */
  .runninghead__progress {
    position: absolute;
    inset-block-end: calc(-1 * var(--rule-weight));
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: var(--rule-weight);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    /* Eased, so the rule trails the scroll and settles rather than snapping
       frame-by-frame with it. Linear rather than a curve: an ease-out would
       make it lunge and then creep, which draws the eye — the point is that
       it should be findable when looked for and unnoticeable when not.

       This is a revision to condition 2 of the motion amendment in
       tokens.css, which originally forbade any transition. The condition was
       written to keep the indicator from animating AT the reader; a 240ms
       linear catch-up does the opposite, since it removes the jitter that was
       drawing attention in the first place. */
    transition: transform 240ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Asked for no motion: the rule still reports position, it just arrives
       there immediately instead of travelling. */
    .runninghead__progress {
      transition: none;
    }
  }

  .runninghead__section {
    /* The only part that changes, and the reason the bar exists. Truncated
       rather than wrapped: a running head that grows to two lines moves the
       page under the reader. */
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
    font-weight: var(--weight-regular);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ==========================================================================
     POSITION LINE
     Where the format announces itself. Roman, spelled-out and arabic in one
     line, each in its own treatment, so a reader who has never seen this
     structure before can tell that three different kinds of thing are being
     counted — before reading the words that say so.

     Everything here is apparatus-sized. The line is orientation, not a
     headline; the h1 underneath is the headline, and a position line that
     competed with it would make the page look like it had two titles.
     ====================================================================== */

  .position__block {
    grid-column: 3;
    grid-row: 2;
  }

  .position {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    margin-block: 0 var(--space-3);
    font-family: var(--font-text);
    font-size: var(--type-apparatus-size);
    line-height: var(--type-apparatus-leading);
    color: var(--muted);
  }

  .position__seg {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  /* "Part" and "Chapter" — the labels that teach the convention.
     Set smaller and lighter than the numerals they introduce, because once
     the convention is learned they are the part that stops being read. */
  .position__level {
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    font-weight: var(--weight-medium);
  }

  /* SPELLED OUT. A word rather than a figure is what separates the grouping
     level from the unit inside it — "Part Two · Chapter 5" needs no other cue
     to read as two different kinds of counting. */
  .position__word {
    color: var(--ink-2);
  }

  /* ARABIC, lining and tabular so the digit sits on the same rail as every
     other number in the apparatus. */
  .position__arabic {
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: var(--weight-medium);
    color: var(--ink);
  }

  .position__dot {
    /* The lightest thing on the line, but still ON it: at --rule these
       disappeared entirely and the three segments ran together into one
       phrase. A separator that cannot be seen is not separating anything. */
    color: var(--muted);
    opacity: 0.6;
  }

  /* ==========================================================================
     NAV
     ====================================================================== */

  .part-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-4);
    border-block-start: var(--rule-weight) solid var(--rule);
  }

  .part-nav__slot--up {
    text-align: center;
  }

  .part-nav__slot--next {
    text-align: end;
  }

  .part-nav__link {
    display: block;
    max-width: 22ch;
    color: var(--ink);
    text-decoration: none;
  }

  .part-nav__slot--up .part-nav__link {
    margin-inline: auto;
  }

  .part-nav__slot--next .part-nav__link {
    margin-inline-start: auto;
  }

  .part-nav__title {
    display: block;
    margin-block-start: var(--space-1);
    font-family: var(--font-doc);
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-leading);
  }

  .part-nav__link:hover .part-nav__title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 56.25em) {
    /* Duplicated from --bp-margin-collapse; media conditions cannot read
       custom properties. */
    .part-nav {
      grid-template-columns: 1fr;
    }

    .part-nav__slot--up,
    .part-nav__slot--next {
      text-align: start;
    }

    .part-nav__slot--up .part-nav__link,
    .part-nav__slot--next .part-nav__link {
      margin-inline: 0;
    }
  }
</style>
