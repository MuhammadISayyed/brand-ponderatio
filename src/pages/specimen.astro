---
/**
 * TEMPORARY. A type specimen for choosing the body and display faces.
 *
 * Renders the same opening — dateline, title, deck, drop cap, sidenote,
 * section heading — in each candidate stack, in the real layout, on the real
 * cream, with the real cinnabar. Metrics do not settle this; only seeing the
 * page does.
 *
 * Delete this file and the SPECIMEN ONLY block in astro.config.mjs once the
 * decision is made.
 */
import { Font } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Sizes are per-stack, not shared. Alegreya sets 15% narrower than Literata
 * with a 10% smaller x-height, so matching them at the same px would be
 * comparing a smaller face against a larger one and calling the difference
 * taste. Each stack is set at the size that puts ~66 characters on a 640px
 * line, which is the only fair comparison.
 */
const stacks = [
  {
    id: 'shipping',
    label: 'Shipping now',
    body: 'Literata',
    display: 'Instrument Serif 400',
    meta: 'Inter',
    measured: '64.9 characters per line',
    vars: {
      '--spec-body': 'var(--font-body)',
      '--spec-display': 'var(--font-display)',
      '--spec-meta': 'var(--font-meta)',
      '--spec-body-size': '1.25rem',
      '--spec-deck-size': '1.5rem',
      '--spec-h2-size': '1.75rem',
      '--spec-title-size': '5rem',
      '--spec-title-weight': '400',
      '--spec-title-leading': '1.05',
      '--spec-meta-size': '0.8125rem',
    },
  },
  {
    id: 'alegreya-black',
    label: 'Alegreya + Alegreya Black',
    body: 'Alegreya 400',
    display: 'Alegreya 900',
    meta: 'Alegreya Sans',
    measured: '66.4 characters per line at 23px',
    vars: {
      '--spec-body': 'var(--font-alegreya)',
      '--spec-display': 'var(--font-alegreya)',
      '--spec-meta': 'var(--font-alegreya-sans)',
      '--spec-body-size': '1.4375rem' /* 23px */,
      '--spec-deck-size': '1.75rem' /* 28px */,
      '--spec-h2-size': '2rem' /* 32px */,
      '--spec-title-size': '4rem' /* 64px — Black is heavy where Instrument
                                     Serif was light, so it needs less */,
      '--spec-title-weight': '900',
      '--spec-title-leading': '1.0',
      '--spec-meta-size': '0.875rem' /* 14px — Alegreya Sans runs smaller on
                                        the body than Inter */,
    },
  },
  {
    id: 'alegreya-sc',
    label: 'Alegreya + Alegreya SC',
    body: 'Alegreya 400',
    display: 'Alegreya SC 500',
    meta: 'Alegreya Sans',
    measured: 'included for comparison — you chose Black, but this is nearly free to look at',
    vars: {
      '--spec-body': 'var(--font-alegreya)',
      '--spec-display': 'var(--font-alegreya-sc)',
      '--spec-meta': 'var(--font-alegreya-sans)',
      '--spec-body-size': '1.4375rem',
      '--spec-deck-size': '1.75rem',
      '--spec-h2-size': '2rem',
      '--spec-title-size': '3.25rem' /* 52px — caps read larger than
                                        lowercase at the same size */,
      '--spec-title-weight': '500',
      '--spec-title-leading': '1.1',
      '--spec-meta-size': '0.875rem',
    },
  },
];

const toStyle = (vars: Record<string, string>) =>
  Object.entries(vars)
    .map(([k, v]) => `${k}:${v}`)
    .join(';');
---

<BaseLayout title="Type specimen" description="Candidate type stacks, in situ.">
  <Fragment slot="head">
    <Font cssVariable="--font-alegreya" preload />
    <Font cssVariable="--font-alegreya-sc" />
    <Font cssVariable="--font-alegreya-sans" />
  </Fragment>

  <div class="specimen">
    <h1 class="specimen__heading">Type specimen</h1>
    <p class="specimen__intro">
      The same opening in each candidate stack. Each is set at the size that
      puts roughly 66 characters on a 640&thinsp;px line, so the comparison is
      between faces rather than between sizes.
    </p>

    {
      stacks.map((stack) => (
        <section class="spec" id={stack.id} style={toStyle(stack.vars)}>
          <div class="spec__tag">
            <p class="label">{stack.label}</p>
            <p class="spec__meta">
              body {stack.body} · display {stack.display} · meta {stack.meta}
              <br />
              {stack.measured}
            </p>
          </div>

          <article class="spec__page">
            <p class="spec__dateline">
              <span>Essay</span>
              <time datetime="2026-07-30">30 July 2026</time>
            </p>

            <h2 class="spec__title">A system is what it refuses</h2>

            <p class="spec__deck">
              Design systems ship as catalogues of what you may do. The ones
              that survive are catalogues of what you may not — and the
              difference is not a matter of tone.
            </p>

            <div class="spec__grid">
              <div class="spec__prose">
                <p class="spec__first">
                  Every design system I have been handed arrives as a
                  catalogue. Here are the colours, here are the type sizes,
                  here are the spacing steps, here are the components; and
                  here, usually in an appendix, usually written last, are some
                  notes on when to reach for which. The catalogue is generous.
                  It is also, within about six months, useless — not because
                  anyone violated it, but because everyone followed it.
                  <span class="spec__ref">1</span>
                  <span class="spec__note">
                    <span class="spec__num">1</span>
                    <span>
                      A list of permitted moves does not narrow a design space.
                      It enumerates one, and an enumerated space is a space you
                      can wander in forever.
                    </span>
                  </span>
                </p>

                <h3 class="spec__h2">Two kinds of constraint</h3>

                <p>
                  A governing constraint removes options and stops there. Every
                  button is 44 pixels tall. Nothing composes differently
                  afterwards; there is simply less to choose from. These are
                  worth having — most accessibility floors are exactly this
                  shape — but they are inert.
                </p>
              </div>
            </div>
          </article>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .specimen {
    max-width: var(--grid-figure-span);
    margin-inline: auto;
  }

  .specimen__heading {
    font-size: var(--type-title-note-size);
    line-height: var(--type-title-note-leading);
    margin-block-end: var(--space-4);
  }

  .specimen__intro {
    max-width: var(--grid-main-col);
    color: var(--ink-2);
    margin-block-end: var(--space-9);
  }

  .spec + .spec {
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-8);
    border-block-start: var(--rule-weight) solid var(--rule);
  }

  .spec__tag {
    margin-block-end: var(--space-7);
  }

  .spec__meta {
    margin-block-start: var(--space-2);
    font-family: var(--font-meta);
    font-size: var(--type-sidenote-size);
    line-height: var(--type-sidenote-leading);
    color: var(--muted);
  }

  /* ---- the specimen page itself, driven entirely by the per-stack vars --- */

  .spec__dateline {
    display: flex;
    gap: var(--space-4);
    margin-block-end: var(--space-4);
    font-family: var(--spec-meta);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    font-weight: var(--weight-medium);
    color: var(--muted);
  }

  .spec__dateline span {
    color: var(--ink);
  }

  .spec__title {
    font-family: var(--spec-display);
    font-size: var(--spec-title-size);
    font-weight: var(--spec-title-weight);
    line-height: var(--spec-title-leading);
    letter-spacing: -0.01em;
    margin-block: 0 var(--space-5);
    text-wrap: balance;
  }

  .spec__deck {
    font-family: var(--spec-body);
    font-size: var(--spec-deck-size);
    line-height: 1.4;
    color: var(--ink-2);
    max-width: var(--grid-main-col);
    margin-block-end: var(--space-8);
    text-wrap: pretty;
  }

  .spec__grid {
    display: grid;
    grid-template-columns:
      var(--grid-margin-col)
      var(--grid-gutter)
      var(--grid-main-col);
  }

  .spec__prose {
    grid-column: 3;
    font-family: var(--spec-body);
    font-size: var(--spec-body-size);
    line-height: var(--type-body-leading);
  }

  .spec__prose p {
    margin-block-end: var(--space-5);
    text-wrap: pretty;
  }

  .spec__first::first-letter {
    -webkit-initial-letter: var(--dropcap-lines);
    initial-letter: var(--dropcap-lines);
    font-family: var(--spec-display);
    font-weight: var(--spec-title-weight);
    margin-inline-end: 0.08em;
  }

  .spec__h2 {
    font-family: var(--spec-body);
    font-size: var(--spec-h2-size);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    margin-block: var(--space-8) var(--space-4);
  }

  .spec__ref {
    font-family: var(--spec-meta);
    font-size: 0.6em;
    vertical-align: super;
    color: var(--accent);
    margin-inline-start: 0.15em;
  }

  .spec__note {
    display: block;
    float: inline-start;
    clear: inline-start;
    inline-size: var(--grid-margin-col);
    margin-inline-start: calc(
      -1 * (var(--grid-margin-col) + var(--grid-gutter))
    );
    margin-block: 0.35rem var(--space-3);
    padding-inline-start: 1.35rem;
    position: relative;
    font-family: var(--spec-meta);
    font-size: var(--spec-meta-size);
    line-height: var(--type-sidenote-leading);
    color: var(--ink-2);
  }

  .spec__num {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    color: var(--accent);
  }

  @media (max-width: 56.25em) {
    .spec__grid {
      display: block;
    }

    .spec__note {
      float: none;
      inline-size: auto;
      margin-inline-start: 0;
      margin-block: var(--space-4);
      padding-inline-start: var(--space-6);
      border-inline-start: var(--rule-weight) solid var(--rule);
    }

    .spec__num {
      inset-inline-start: var(--space-4);
    }
  }
</style>
