---
/**
 * Groundings — the same listing as the index, filtered to groundings.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { groundingItems } from '../../lib/listing';

const items = await groundingItems();
---

<BaseLayout
  title="Groundings"
  description="Groundings — long works, published complete, read in order."
>
  <div class="article">
    <header class="article__header">
      {/* Headline only. A label reading "Groundings" above a headline reading
          "Groundings" says it twice, and a section page needs no standfirst — the
          list underneath is the description. */}
      <h1 class="article__title display-title">Groundings</h1>
    </header>

    <EntryList items={items} empty="No groundings yet." />
  </div>
</BaseLayout>
