---
/**
 * One part of a grounding, routed by SLUG. Not by the part number, roman or
 * arabic — numbers move when the argument is revised, and a shared URL that
 * silently points at a different part is worse than one that 404s. See
 * partSlug in lib/groundings.
 */
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PartLayout from '../../../layouts/PartLayout.astro';
import { groundingSlugs, getParts, partSlug } from '../../../lib/groundings';

export const getStaticPaths = (async () => {
  const routes = [];
  for (const grounding of groundingSlugs()) {
    const parts = await getParts(grounding);
    for (const [i, part] of parts.entries()) {
      routes.push({
        params: { grounding, part: partSlug(part) },
        props: {
          grounding,
          part,
          total: parts.length,
          previous: parts[i - 1],
          next: parts[i + 1],
        },
      });
    }
  }
  return routes;
}) satisfies GetStaticPaths;

const { grounding, part, total, previous, next } = Astro.props;
const { Content, headings } = await render(part);
---

<PartLayout
  grounding={grounding}
  part={part}
  headings={headings}
  total={total}
  previous={previous}
  next={next}
>
  <Content />
</PartLayout>
