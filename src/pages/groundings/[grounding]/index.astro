---
/**
 * A grounding's spine — its front door and table of contents.
 *
 * NOT a list of titles. For a cumulative argument the contents page is the
 * argument in outline, and a reader should be able to see the shape of the
 * case — and why Part III has to follow Part II — before reading a word. That
 * is what `deck` carries on each part: what the part ESTABLISHES.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import {
  GROUNDINGS, groundingSlugs, getParts, partHref, roman,
} from '../../../lib/groundings';

export const getStaticPaths = (async () =>
  groundingSlugs().map((grounding) => ({ params: { grounding } }))) satisfies GetStaticPaths;

const { grounding } = Astro.params;
const work = GROUNDINGS[grounding!];
const parts = await getParts(grounding!);
---

<BaseLayout title={work.title} description={work.abstract}>
  <div class="article">
    <header class="article__header">
      <div class="article__topline">
        <Breadcrumb trail={[{ href: '/groundings/', label: 'Groundings' }]} />
      </div>

      <h1 class="article__title display-title">{work.title}</h1>

      <div class="article__band spine__band">
        {/* Guarded: roman() rejects zero, and a grounding with no parts yet
            is an empty state rather than an error. */}
        <p class="label spine__count">
          {parts.length > 0 ? `${roman(parts.length)} parts` : 'No parts yet'}
        </p>
      </div>

      <p class="article__deck">{work.abstract}</p>
    </header>

    <ol class="contents">
      {
        parts.map((part) => (
          <li class="contents__item">
            <p class="label contents__number">Part {roman(part.data.part)}</p>
            <div class="contents__body">
              <h2 class="contents__title">
                <a href={partHref(grounding!, part)}>{part.data.title}</a>
              </h2>
              {part.data.deck && (
                <p class="contents__deck">{part.data.deck}</p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    {parts.length === 0 && <p class="contents__empty">No parts written yet.</p>}
  </div>
</BaseLayout>

<style>
  /* THE COUNT STANDS IN THE MARGIN COLUMN, not on the text rail.
     "III parts" and the "Part I / II / III" numerals below it are the same
     thing said twice — a total and its members — so they belong on the same
     vertical edge. On the text rail the count was a fourth left edge in the
     header, announcing a list whose numerals began 190px to its left; here it
     reads as the head of the column of numerals it counts.

     This is the one place the band is not the byline. An essay's band is a
     line of prose-register provenance and belongs with the prose; this is
     apparatus, and the margin column is where apparatus lives.

     AND IT RIDES UP TO THE TOPLINE ROW, level with the breadcrumb. Left in
     the band's own row it aligned correctly and still read badly: stranded in
     146px of whitespace between the deck and the first numeral, too far from
     the list to head it and too far from the header to belong to it. That gap
     cannot be closed from column 1, because the same row has to hold the deck
     clear of the first part's title in column 3 — one row, two spacings, and
     the reading column has the stronger claim. On the top line the whitespace
     below is plainly the header's, not an orphan's, and the line reads across
     as a masthead: what this belongs to on the text rail, how big it is on
     the apparatus rail. */
  .spine__band {
    grid-column: 1;
    grid-row: 1;
    margin-block-start: 0;
    /* Both sides of the line are single-line labels at the same size, so the
       baselines meet without being told to — but the band is a flex row that
       centres by default, and a wrapped count would otherwise drift off the
       breadcrumb's baseline. */
    align-items: baseline;
  }

  .spine__count {
    color: var(--ink);
  }

  /* The contents spans the whole grid so each entry can put its numeral in
     the margin column — the same edge the index metadata and figure numbers
     align to, so the page keeps one vertical line for apparatus. */
  .contents {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: subgrid;
  }

  .contents__item {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    padding-block: var(--space-7);
  }

  .contents__number {
    grid-column: 1;
    /* Same rail as every other thing in the margin column, and level with
       the first line of the title beside it rather than with the top of its
       box. */
    margin-block-start: 0.15em;
  }

  .contents__body {
    grid-column: 3;
  }

  .contents__title {
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-leading);
    margin-block: 0;
  }

  .contents__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .contents__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .contents__deck {
    margin-block: var(--space-2) 0;
    font-size: var(--type-index-deck-size);
    line-height: var(--type-index-deck-leading);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .contents__empty {
    grid-column: 3;
    color: var(--muted);
  }

  @media (max-width: 56.25em) {
    /* Duplicated from --bp-margin-collapse; media conditions cannot read
       custom properties. */
    .contents,
    .contents__item {
      display: block;
    }

    .contents__number {
      margin-block: 0 var(--space-2);
    }
  }
</style>
