---
/**
 * A grounding's spine — its front door and table of contents.
 *
 * NOT a list of titles. For a cumulative argument the contents page is the
 * argument in outline, and a reader should be able to see the shape of the
 * case — and why Part III has to follow Part II — before reading a word. That
 * is what `deck` carries on each part: what the part ESTABLISHES.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import {
  GROUNDINGS, groundingSlugs, getParts, partHref, roman,
} from '../../../lib/groundings';

export const getStaticPaths = (async () =>
  groundingSlugs().map((grounding) => ({ params: { grounding } }))) satisfies GetStaticPaths;

const { grounding } = Astro.params;
const work = GROUNDINGS[grounding!];
const parts = await getParts(grounding!);
---

<BaseLayout title={work.title} description={work.abstract}>
  <div class="article">
    <header class="article__header">
      <div class="article__topline">
        <Breadcrumb trail={[{ href: '/groundings/', label: 'Groundings' }]} />
      </div>

      <h1 class="article__title display-title">{work.title}</h1>

      <div class="article__aside">
        <p class="label spine__count">{roman(parts.length)} parts</p>
      </div>

      <p class="article__deck">{work.abstract}</p>
    </header>

    <ol class="contents">
      {
        parts.map((part) => (
          <li class="contents__item">
            <p class="label contents__number">Part {roman(part.data.part)}</p>
            <div class="contents__body">
              <h2 class="contents__title">
                <a href={partHref(grounding!, part)}>{part.data.title}</a>
              </h2>
              {part.data.deck && (
                <p class="contents__deck">{part.data.deck}</p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    {parts.length === 0 && <p class="contents__empty">No parts written yet.</p>}
  </div>
</BaseLayout>

<style>
  .spine__count {
    text-align: end;
    color: var(--ink);
  }

  @media (max-width: 56.25em) {
    .spine__count {
      text-align: start;
      margin-block-end: var(--space-5);
    }
  }

  /* The contents spans the whole grid so each entry can put its numeral in
     the margin column — the same edge the index metadata and figure numbers
     align to, so the page keeps one vertical line for apparatus. */
  .contents {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: subgrid;
  }

  .contents__item {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    padding-block: var(--space-6);
  }

  .contents__number {
    grid-column: 1;
    text-align: end;
  }

  .contents__body {
    grid-column: 3;
  }

  .contents__title {
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-leading);
    margin-block: 0;
  }

  .contents__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .contents__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .contents__deck {
    margin-block: var(--space-2) 0;
    font-size: var(--type-index-deck-size);
    line-height: var(--type-index-deck-leading);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .contents__empty {
    grid-column: 3;
    color: var(--muted);
  }

  @media (max-width: 56.25em) {
    /* Duplicated from --bp-margin-collapse; media conditions cannot read
       custom properties. */
    .contents,
    .contents__item {
      display: block;
    }

    .contents__number {
      text-align: start;
      margin-block-end: var(--space-2);
    }
  }
</style>
