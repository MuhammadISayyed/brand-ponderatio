---
/**
 * Essays — the same listing as the index, filtered to posts.
 *
 * It renders through the same <EntryList> the index and the groundings page
 * use, so the three cannot drift into looking like three different sites.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { postItems } from '../../lib/listing';

const items = await postItems();
---

<BaseLayout
  title="Essays"
  description="Essays — standalone arguments, newest first."
>
  <div class="article">
    <header class="article__header">
      {/* Headline only. A label reading "Essays" above a headline reading
          "Essays" says it twice, and a section page needs no standfirst — the
          list underneath is the description. */}
      <h1 class="article__title display-title">Essays</h1>
    </header>

    <EntryList items={items} empty="No essays yet." />
  </div>
</BaseLayout>
