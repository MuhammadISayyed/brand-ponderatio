---
/**
 * The essay route. There is one layout now — the note register that this used
 * to dispatch between is gone, so nothing chooses.
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import EssayLayout from '../../layouts/EssayLayout.astro';
import { postSlug } from '../../lib/format';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) =>
    // Drafts are visible while writing and never built for production.
    import.meta.env.PROD ? !data.draft : true,
  );

  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---

<EssayLayout post={post}>
  <Content />
</EssayLayout>
