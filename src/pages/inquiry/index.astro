---
/**
 * The spine — the work's front door and its table of contents.
 *
 * NOT a list of titles. For a cumulative argument the contents page is the
 * argument in outline, and a reader should be able to see the shape of the
 * case — and why part 3 has to follow part 2 — before reading a word. That is
 * what `deck` carries on each part: what the part ESTABLISHES, not what it is
 * about.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INQUIRY, getParts, partHref } from '../../lib/inquiry';

const parts = await getParts();
---

<BaseLayout title={INQUIRY.title} description={INQUIRY.abstract}>
  <div class="article">
    <header class="article__header">
      <p class="article__dateline label">
        <span>Inquiry</span>
        <span>{parts.length} parts</span>
      </p>
      <h1 class="article__title display-title">{INQUIRY.title}</h1>
      <p class="article__deck">{INQUIRY.abstract}</p>
    </header>

    <ol class="contents">
      {
        parts.map((part) => (
          <li class="contents__item">
            <p class="label contents__number">Part {part.data.part}</p>
            <div class="contents__body">
              <h2 class="contents__title">
                <a href={partHref(part.data.part)}>{part.data.title}</a>
              </h2>
              <p class="contents__deck">{part.data.deck}</p>
            </div>
          </li>
        ))
      }
    </ol>

    {parts.length === 0 && <p class="contents__empty">No parts written yet.</p>}
  </div>
</BaseLayout>

<style>
  /* The contents spans the whole grid so each entry can put its number in the
     margin column — the same edge the index metadata and figure numbers align
     to, so the page keeps one vertical line for apparatus. */
  .contents {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: subgrid;
  }

  .contents__item {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    padding-block: var(--space-6);
  }

  .contents__number {
    grid-column: 1;
    text-align: end;
  }

  .contents__body {
    grid-column: 3;
  }

  .contents__title {
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-leading);
    margin-block: 0;
  }

  .contents__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .contents__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .contents__deck {
    margin-block: var(--space-2) 0;
    font-size: var(--type-index-deck-size);
    line-height: var(--type-index-deck-leading);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .contents__empty {
    grid-column: 3;
    color: var(--muted);
  }

  @media (max-width: 56.25em) {
    /* Duplicated from --bp-margin-collapse; media conditions cannot read
       custom properties. */
    .contents,
    .contents__item {
      display: block;
    }

    .contents__number {
      text-align: start;
      margin-block-end: var(--space-2);
    }
  }
</style>
