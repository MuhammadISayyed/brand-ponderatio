---
/**
 * The index. Everything, in one reverse-chronological list — there are no
 * separate archives per kind, because the filing system is the reference code
 * and the tags, not the route.
 *
 * Entries reuse the essay grid: apparatus in the margin column, title and
 * deck in the main column. The list reads as a continuation of the posts.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDateline, kindLabel, machineDate, postHref } from '../lib/format';

const posts = await getCollection('posts', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

// Newest first. `date` is a Date by the time the schema is done with it, so
// this is an arithmetic sort, not a string one.
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Muhammad Ibrahim">
  <div class="index">
    <h1 class="index__heading">Index</h1>

    <ol class="index__list">
      {
        posts.map((post) => {
          const { title, deck, date, kind, ref } = post.data;
          return (
            <li class="entry">
              <div class="entry__meta stub">
                <p class="label">
                  {kind === 'note' && ref ? ref : kindLabel(kind)}
                </p>
                <p class="entry__date">
                  <time datetime={machineDate(date)}>
                    {formatDateline(date)}
                  </time>
                </p>
              </div>

              <div class="entry__body">
                <h2 class="entry__title">
                  <a href={postHref(post.id)}>{title}</a>
                </h2>
                {deck && <p class="entry__deck">{deck}</p>}
              </div>
            </li>
          );
        })
      }
    </ol>

    {posts.length === 0 && <p class="index__empty">Nothing filed yet.</p>}
  </div>
</BaseLayout>

<style>
  .index {
    max-width: var(--grid-figure-span);
    margin-inline: auto;
  }

  .index__heading {
    font-size: var(--type-title-note-size);
    line-height: var(--type-title-note-leading);
    /* The first entry brings its own top padding; anything more here opens a
       hole between the heading and the list it heads. */
    margin-block-end: var(--space-4);
  }

  /* Entries were separated by a full-width oxide rule each, which turned a
     reading list into a table and spent the accent on every row — where it
     marked nothing, because everything had one.

     What separates them now is the space between them and the hard vertical
     edge of the right-aligned margin column. The accent survives as the stub
     above each entry's metadata: a run of short ticks down the left of the
     page, which reads as a filing run in a way a stack of full-width rules
     never did. */
  .entry {
    display: grid;
    grid-template-columns:
      var(--grid-margin-col)
      var(--grid-gutter)
      var(--grid-main-col);
    padding-block: var(--space-7);
  }

  .entry__meta {
    grid-column: 1;
    /* Right-aligned against the gutter. The metadata column ends on one
       straight edge instead of ragging, and that edge does the dividing. */
    text-align: end;
  }

  /* The stub aligns with the column's right edge, not its left. */
  .entry__meta.stub::before {
    margin-inline-start: auto;
    margin-block-end: var(--space-3);
  }

  .entry__body {
    grid-column: 3;
  }

  .entry .label {
    /* Index labels carry the entry's identity — its reference code or its
       kind — so they take the reader's ink rather than metadata grey. */
    color: var(--ink);
  }

  .entry__date {
    margin-block: var(--space-2) 0;
    font-family: var(--font-sans-meta);
    font-size: var(--type-sidenote-size);
    line-height: var(--type-sidenote-leading);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--muted);
  }

  .entry__title {
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-leading);
    margin-block: 0;
  }

  .entry__title a {
    /* Index titles are the page's content, not links inside running text.
       The accent underline would turn the list into a wall of oxide. */
    color: var(--ink);
    text-decoration: none;
  }

  .entry__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .entry__deck {
    margin-block: var(--space-3) 0;
    font-size: var(--type-index-deck-size);
    line-height: var(--type-index-deck-leading);
    color: var(--ink-2);
    /* The index is a list of pointers, not a place to read. Two lines of
       summary is a pointer; five is the post itself, badly set. */
    max-width: 58ch;
    text-wrap: pretty;
  }

  .index__empty {
    color: var(--muted);
  }

  @media (max-width: 56.25em) {
    /* Duplicated from --bp-margin-collapse; media conditions cannot read
       custom properties. */
    .index {
      max-width: var(--grid-main-col);
    }

    .entry {
      display: block;
    }

    .entry__meta {
      /* No margin column to align against, so the metadata goes back to
         reading left to right. The two paragraphs run inline on one line
         rather than the column becoming a flex row — as flex items the
         stub would be stretched to the full width and stop being a stub. */
      text-align: start;
      margin-block-end: var(--space-3);
    }

    .entry__meta p {
      display: inline;
    }

    .entry__date {
      margin-inline-start: var(--space-3);
    }

    .entry__meta.stub::before {
      margin-inline-start: 0;
      margin-block-end: var(--space-3);
    }

    .entry__date {
      margin-block: 0;
    }
  }
</style>
