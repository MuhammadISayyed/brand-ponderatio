---
/**
 * Home — everything, newest first.
 *
 * The two section pages show one kind each; this shows both, because a
 * visitor who has just arrived should not have to guess which of two lists
 * holds the thing they were sent to read. Groundings come first: there are
 * few of them and each is a large object, so burying them under a run of
 * essays would hide the biggest thing on the site.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { postItems, groundingItems } from '../lib/listing';

const items = [...(await groundingItems()), ...(await postItems())];
---

<BaseLayout title="Brand Ponderatio">
  <div class="article">
    <h1 class="u-sr-only">Brand Ponderatio</h1>
    <EntryList items={items} />
  </div>
</BaseLayout>
