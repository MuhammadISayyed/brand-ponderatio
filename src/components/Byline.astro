---
/**
 * Who wrote the thing you are reading.
 *
 * The site is Brand Ponderatio and the header carries its emblem; this
 * carries a person. Keeping the two apart is the whole reason both can be
 * quiet — the mark says whose publication this is, the byline says who is
 * talking.
 *
 * THE PORTRAIT IS SQUARE-CROPPED AT BUILD TIME. The camera original is
 * 4160x6240 and 8.9MB, which is four hundred times the pixels this needs; it
 * lives in originals/ and is gitignored. src/assets/portrait.jpg is a 512px
 * square cropped around the FACE rather than around the frame — a centred
 * crop of a portrait puts the chin in the middle of the circle.
 *
 * <Image> takes it from there: Astro emits the sizes and formats, so the
 * circle costs a few kilobytes rather than the megabytes it started at.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

const AUTHOR = 'Muhammad Ibrahim';
---

<p class="byline">
  <Image
    class="byline__portrait"
    src={portrait}
    alt=""
    width={108}
    height={108}
    densities={[1, 2, 3]}
  />
  <span class="byline__name">{AUTHOR}</span>
</p>

<style>
  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block: 0;
  }

  .byline__portrait {
    /* Fixed square, clipped to a circle — a portrait that is not square gets
       cropped to centre rather than squashed. */
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
    /* The cream is light enough that a portrait can bleed into it; the
       hairline gives the circle an edge without drawing one. */
    box-shadow: 0 0 0 var(--rule-weight) var(--rule);
  }

  .byline__name {
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    font-weight: var(--weight-medium);
    color: var(--ink);
  }
</style>
