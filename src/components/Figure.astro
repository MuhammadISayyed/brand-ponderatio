---
/**
 * A figure, numbered automatically, with its number in the margin column.
 *
 *   <Figure>
 *     <svg …/>
 *     <Fragment slot="caption">What the diagram argues.</Fragment>
 *   </Figure>
 *
 * The number was typed by hand into the caption before this existed, which
 * meant renumbering was a manual edit.
 *
 * IT SITS WITH ITS CAPTION, not in the margin column. The margin placement
 * was the token file's original rule and it was wrong in practice: a figure
 * number is not apparatus about the page, it is the first two words of the
 * caption — "Fig. 1 —" is how the sentence starts. Parked in the margin it
 * sat level with the top of the artwork, a column away from the text that
 * completes it.
 *
 * Numbering uses the same Request-keyed counter as sidenotes: one page render
 * is one Request, so figures restart at 1 on every page.
 */
import { nextFigureNumber } from '../lib/figure-counter';

interface Props {
  /** Optional: overrides the generated id, for linking to a specific figure. */
  id?: string;
}

const n = nextFigureNumber(Astro.request);
const { id = `fig-${n}` } = Astro.props;
---

<figure class="figure" id={id}>
  <slot />

  <figcaption class="figure__caption">
    <span class="figure__number">Fig.&nbsp;{n}&nbsp;—&nbsp;</span><slot
      name="caption"
    />
  </figcaption>
</figure>

<style>
  .figure__number {
    color: var(--muted);
  }
</style>
