---
/**
 * The listing. One component, used by the index, the essays page and the
 * groundings page — so "the same view" is a fact rather than a resemblance
 * three templates happen to maintain.
 *
 * Entries were separated by a full-width oxide rule each, which turned a
 * reading list into a table and spent the accent on every row, where it
 * marked nothing because everything had one. What separates them now is the
 * space between them and the hard vertical edge of the right-aligned margin
 * column. The accent survives as the stub above each entry: a run of short
 * ticks down the left, which reads as a filing run in a way a stack of
 * full-width rules never did.
 */
import type { ListItem } from '../lib/listing';

interface Props {
  items: ListItem[];
  /** Shown when there is nothing to list. */
  empty?: string;
}

const { items, empty = 'Nothing filed yet.' } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="entries__empty">{empty}</p>
  ) : (
    <ol class="entries">
      {items.map((item) => (
        <li class="entry">
          <div class="entry__meta stub">
            <p class="label">{item.label}</p>
            <p class="entry__sub">
              {item.datetime ? (
                <time datetime={item.datetime}>{item.meta}</time>
              ) : (
                item.meta
              )}
            </p>
          </div>

          <div class="entry__body">
            <h2 class="entry__title">
              <a href={item.href}>{item.title}</a>
            </h2>
            {item.deck && <p class="entry__deck">{item.deck}</p>}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .entries {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .entry {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    padding-block: var(--space-7);
  }

  .entry__meta {
    grid-column: 1;
    /* Right-aligned against the gutter. The metadata column ends on one
       straight edge instead of ragging, and that edge does the dividing. */
    text-align: end;
  }

  /* The stub aligns with the column's right edge, not its left. */
  .entry__meta.stub::before {
    margin-inline-start: auto;
    margin-block-end: var(--space-3);
  }

  .entry .label {
    /* Labels carry the entry's identity — its kind, its reference code — so
       they take the reader's ink rather than metadata grey. */
    color: var(--ink);
  }

  .entry__sub {
    margin-block: var(--space-2) 0;
    font-family: var(--font-text);
    font-size: var(--type-apparatus-size);
    line-height: var(--type-apparatus-leading);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--muted);
  }

  .entry__body {
    grid-column: 3;
  }

  .entry__title {
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-leading);
    margin-block: 0;
  }

  .entry__title a {
    /* Titles here are the page's content, not links inside running text. The
       accent underline would turn the list into a wall of oxide. */
    color: var(--ink);
    text-decoration: none;
  }

  .entry__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .entry__deck {
    margin-block: var(--space-3) 0;
    font-size: var(--type-index-deck-size);
    line-height: var(--type-index-deck-leading);
    color: var(--ink-2);
    /* A listing is a set of pointers, not a place to read. Two lines of
       summary is a pointer; five is the post itself, badly set. */
    max-width: 58ch;
    text-wrap: pretty;
  }

  .entries__empty {
    grid-column: 3;
    color: var(--muted);
  }

  @media (max-width: 56.25em) {
    /* Duplicated from --bp-margin-collapse; media conditions cannot read
       custom properties. */
    .entries,
    .entry {
      display: block;
    }

    .entry__meta {
      /* No margin column to align against, so the metadata reads left to
         right. The two paragraphs run inline on one line rather than the
         column becoming a flex row — as flex items the stub would stretch to
         full width and stop being a stub. */
      text-align: start;
      margin-block-end: var(--space-3);
    }

    .entry__meta p {
      display: inline;
    }

    .entry__sub {
      margin-block: 0;
      margin-inline-start: var(--space-3);
    }

    .entry__meta.stub::before {
      margin-inline-start: 0;
      margin-block-end: var(--space-3);
    }
  }
</style>
