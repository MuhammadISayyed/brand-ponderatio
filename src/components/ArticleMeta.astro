---
/**
 * When it went up, and when it last moved.
 *
 * It runs INLINE, because it sits in the centred band beside the byline rather
 * than stacked in the margin column. Grouped with the byline it reads as one
 * line of provenance — who wrote this, and when — which is a sentence the
 * reader can take in at a glance and then leave.
 *
 * THERE IS NO `kind` PROP ANY MORE. There was one, carrying "Part II of III"
 * for a part and nothing for an essay, on the argument that a position is
 * something a breadcrumb cannot express. That argument was sound about
 * positions and wrong about where to put them: a chapter now states its
 * position on its own line above the title, where it belongs, and the band
 * went back to being provenance only. What was left beside the author's name
 * was a label answering a question the page had already answered twice.
 *
 * The dot separators are drawn in CSS rather than typed, so no item has to
 * know whether it is last.
 */
import { formatDateline, machineDate } from '../lib/format';

interface Props {
  published: Date;
  updated?: Date;
}

const { published, updated } = Astro.props;
---

<div class="meta label">
  {/* No "Published" label. The first date on a piece is its publication
      date and needs no announcing; only the exception does, which is why
      "Updated" keeps its word. Dropping it is also what lets the whole line
      fit the measure — it ran 527px into a 512px column and wrapped, putting
      the writer on one line and the dates on another. */}
  <span class="meta__item">
    <time datetime={machineDate(published)}>{formatDateline(published)}</time>
  </span>

  {
    updated && (
      <span class="meta__item">
        <span class="meta__term">Updated</span>
        <time datetime={machineDate(updated)}>{formatDateline(updated)}</time>
      </span>
    )
  }
</div>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .meta__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--muted);
  }

  /* Separators are drawn, not typed, so nothing has to know it is last. */
  .meta__item + .meta__item::before {
    content: '·';
    color: var(--rule);
    margin-inline-end: var(--space-2);
  }

  /* The word is the quiet half and the date is the answer, so the term drops
     out of the label register into plain lowercase — otherwise "PUBLISHED"
     shouts louder than the date it introduces. */
  .meta__term {
    text-transform: none;
    letter-spacing: normal;
    font-weight: var(--weight-regular);
    color: var(--muted);
  }

  .meta time {
    color: var(--ink-2);
    font-variant-numeric: lining-nums tabular-nums;
  }
</style>
