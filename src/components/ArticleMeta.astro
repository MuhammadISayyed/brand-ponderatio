---
/**
 * What this is, when it went up, when it last moved.
 *
 * It runs INLINE, because it now sits in the centred band beside the byline
 * rather than stacked in the margin column. Grouped with the byline it reads
 * as one line of provenance — who wrote this, what it is, when it happened —
 * which is a sentence the reader can take in at a glance and then leave.
 *
 * The dot separators are drawn in CSS rather than typed, so no item has to
 * know whether it is last.
 */
import { formatDateline, machineDate } from '../lib/format';

interface Props {
  /**
   * What this thing is — "Part II of III".
   *
   * OPTIONAL, and an essay passes nothing. The breadcrumb above already says
   * "Essays"; repeating "Essay" here labels the page with a word it has
   * already been given, two lines apart. A part is different: "Part II of
   * III" is a position, which the breadcrumb cannot express.
   */
  kind?: string;
  published: Date;
  updated?: Date;
}

const { kind, published, updated } = Astro.props;
---

<div class="meta label">
  {kind && <span class="meta__item meta__kind">{kind}</span>}

  {/* No "Published" label. The first date on a piece is its publication
      date and needs no announcing; only the exception does, which is why
      "Updated" keeps its word. Dropping it is also what lets the whole line
      fit the measure — it ran 527px into a 512px column and wrapped, putting
      the writer on one line and the dates on another. */}
  <span class="meta__item">
    <time datetime={machineDate(published)}>{formatDateline(published)}</time>
  </span>

  {
    updated && (
      <span class="meta__item">
        <span class="meta__term">Updated</span>
        <time datetime={machineDate(updated)}>{formatDateline(updated)}</time>
      </span>
    )
  }
</div>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .meta__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--muted);
  }

  /* Separators are drawn, not typed, so nothing has to know it is last. */
  .meta__item + .meta__item::before {
    content: '·';
    color: var(--rule);
    margin-inline-end: var(--space-2);
  }

  .meta__kind {
    color: var(--ink);
  }

  /* The word is the quiet half and the date is the answer, so the term drops
     out of the label register into plain lowercase — otherwise "PUBLISHED"
     shouts louder than the date it introduces. */
  .meta__term {
    text-transform: none;
    letter-spacing: normal;
    font-weight: var(--weight-regular);
    color: var(--muted);
  }

  .meta time {
    color: var(--ink-2);
    font-variant-numeric: lining-nums tabular-nums;
  }
</style>
