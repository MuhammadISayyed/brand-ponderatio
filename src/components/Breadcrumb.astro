---
/**
 * The trail of ancestors above a title.
 *
 * TWO RULES, both learned the hard way:
 *
 * 1. It ends at the PARENT, never at the current page. The h1 directly
 *    beneath already says where you are; repeating it is noise that also
 *    doubles the length of the line.
 *
 * 2. Home is omitted. The wordmark in the site header is the home link and
 *    every reader knows it, so a "Home" crumb is a second answer to a
 *    question already answered above it.
 *
 * Labels are full names or destination functions — never abbreviations. A
 * crumb reading "Demand" for a work called "The Dispositional Basis of
 * Demand" makes the reader reconstruct the title from a fragment, which is
 * the opposite of what a breadcrumb is for.
 *
 * STYLED AS CHROME, NOT AS A PROSE LINK. The link doctrine in global.css
 * gives accent and a solid underline to anything leaving the page, which
 * applied literally would put a line of cinnabar above every title. The site
 * header nav already sets the precedent for the other treatment: the accent
 * marks links inside SENTENCES, and navigation furniture stays quiet.
 * Otherwise the accent stops meaning "this sentence points somewhere".
 */
interface Crumb {
  href: string;
  label: string;
}

interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
---

{
  trail.length > 0 && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {trail.map((crumb, i) => (
          <li>
            {i > 0 && (
              <span class="crumbs__sep" aria-hidden="true">
                /
              </span>
            )}
            <a href={crumb.href}>{crumb.label}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .crumbs li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .crumbs a {
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-transform);
    font-weight: var(--weight-medium);
    color: var(--ink);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .crumbs__sep {
    font-family: var(--font-text);
    font-size: var(--type-label-size);
    color: var(--muted);
  }
</style>
